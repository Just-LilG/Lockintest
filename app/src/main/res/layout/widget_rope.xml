<?xml version="1.0" encoding="utf-8"?>
<!--
  Roped, 4x2: you and your partner climbing the logo's mountain towards today's goal.
  The sky, ranges, mountain, rope and climbers are one picture (art), drawn in code behind everything else.
  Between the <!-/- fx -/-> marks are the looping effects; tools/gen_widget_fx.py makes widget_rope_calm.xml without them.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_fill" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/art" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" />
    <!-- fx -->
    <ProgressBar android:id="@+id/fx_stars_a" android:layout_width="120dp" android:layout_height="80dp"
        android:layout_gravity="top|start" android:layout_marginStart="6dp" android:layout_marginTop="2dp"
        android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_fx_stars_a"
        android:indeterminateTint="#FFFFFFFF" android:importantForAccessibility="no" />
    <ProgressBar android:id="@+id/fx_stars_b" android:layout_width="120dp" android:layout_height="80dp"
        android:layout_gravity="top|end" android:layout_marginEnd="48dp" android:layout_marginTop="2dp"
        android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_fx_stars_b"
        android:indeterminateTint="#FFFFFFFF" android:importantForAccessibility="no" />
    <ProgressBar android:id="@+id/fx_stars_c" android:layout_width="120dp" android:layout_height="80dp"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="28dp"
        android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_fx_stars_c"
        android:indeterminateTint="#FFFFFFFF" android:importantForAccessibility="no" />
    <ProgressBar android:id="@+id/fx_shoot" android:layout_width="160dp" android:layout_height="64dp"
        android:layout_gravity="top|end" android:layout_marginEnd="20dp" android:layout_marginTop="42dp"
        android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_fx_shoot"
        android:indeterminateTint="#FFFFFFFF" android:importantForAccessibility="no" />
    <!-- /fx -->
    <ImageView android:id="@+id/rim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_rim" android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/head_icon" android:layout_width="22dp" android:layout_height="13dp"
                android:scaleType="fitCenter" android:src="@drawable/widget_logo" android:importantForAccessibility="no" />
            <TextView android:id="@+id/head_label" style="@style/WidgetCap"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="@string/widget_rope_label" />
            <FrameLayout android:id="@+id/corner" android:layout_width="28dp" android:layout_height="28dp">
                <ImageView android:id="@+id/corner_rim" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_pill_rim" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/corner_icon" android:layout_width="15dp" android:layout_height="15dp"
                    android:layout_gravity="center" android:src="@drawable/ic_w_chat" />
            </FrameLayout>
        </LinearLayout>

        <!-- Where the mountain stands; the low cloud drifts along its foot. -->
        <FrameLayout android:id="@+id/art_slot" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <!-- fx -->
            <ProgressBar android:id="@+id/fx_mist" android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/w_fx_mist"
                android:indeterminateTint="#FFFFFFFF" android:importantForAccessibility="no" />
            <!-- /fx -->
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="2dp">
            <TextView android:id="@+id/me_time" style="@style/WidgetFigure" android:textSize="16sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/me_label" style="@style/WidgetSub"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="5dp" />
            <TextView android:id="@+id/them_label" style="@style/WidgetSub"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="5dp"
                android:maxWidth="110dp" />
            <TextView android:id="@+id/them_time" style="@style/WidgetFigure" android:textSize="16sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Two buttons, or, while a lock runs between you, a line with its countdown. -->
        <LinearLayout android:id="@+id/actions" android:layout_width="match_parent" android:layout_height="32dp"
            android:layout_marginTop="9dp" android:orientation="horizontal">
            <FrameLayout android:id="@+id/primary" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView android:id="@+id/primary_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_pill" android:importantForAccessibility="no" />
                <!-- fx -->
                <ProgressBar android:id="@+id/fx_shimmer" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/w_fx_shimmer_pill"
                    android:indeterminateTint="#FFFFFFFF" android:importantForAccessibility="no" />
                <!-- /fx -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:layout_gravity="center" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/primary_icon" android:layout_width="13dp" android:layout_height="13dp"
                        android:layout_marginEnd="6dp" android:src="@drawable/ic_w_lock" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/primary_text" style="@style/WidgetButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/ghost" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginStart="8dp">
                <ImageView android:id="@+id/ghost_rim" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_pill_rim" android:importantForAccessibility="no" />
                <TextView android:id="@+id/ghost_text" style="@style/WidgetButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:paddingStart="10dp" android:paddingEnd="10dp" />
            </FrameLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/status" android:layout_width="match_parent" android:layout_height="32dp"
            android:layout_marginTop="9dp" android:visibility="gone">
            <ImageView android:id="@+id/status_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_pill" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="14dp">
                <ImageView android:id="@+id/status_icon" android:layout_width="13dp" android:layout_height="13dp"
                    android:src="@drawable/ic_w_lock" android:importantForAccessibility="no" />
                <TextView android:id="@+id/status_text" style="@style/WidgetSub" android:textSize="12.5sp"
                    android:fontVariationSettings="\'wght\' 600"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="7dp" />
                <Chronometer android:id="@+id/status_clock" style="@style/WidgetFigure" android:textSize="14sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
