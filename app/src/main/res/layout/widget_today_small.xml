<?xml version="1.0" encoding="utf-8"?>
<!-- Today, 2x2: today's ring with the time inside, the streak, and a round Lock in button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_fill" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/glow" android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="center"
        android:scaleType="fitXY" android:src="@drawable/widget_glow" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/sheen" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_sheen" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/rim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_rim" android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/head_icon" android:layout_width="22dp" android:layout_height="13dp"
                android:scaleType="fitCenter" android:src="@drawable/widget_logo" android:importantForAccessibility="no" />
            <TextView android:id="@+id/head_label" style="@style/WidgetCap"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="@string/widget_today_label" />
            <FrameLayout android:id="@+id/chip" android:layout_width="wrap_content" android:layout_height="22dp">
                <ImageView android:id="@+id/chip_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_pill" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="6dp" android:paddingEnd="8dp">
                    <ImageView android:id="@+id/chip_icon" android:layout_width="12dp" android:layout_height="12dp"
                        android:src="@drawable/ic_w_flame" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/chip_text" style="@style/WidgetSub" android:textSize="11.5sp"
                        android:fontVariationSettings="\'wght\' 600"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <FrameLayout android:id="@+id/ring_area" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
            <ImageView android:id="@+id/ring" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" />
            <!-- fx -->
            <ProgressBar android:id="@+id/fx_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_fx_ring"
                android:indeterminateTint="#FFFFFFFF" android:importantForAccessibility="no" />
            <ProgressBar android:id="@+id/fx_done" android:layout_width="match_parent" android:layout_height="match_parent"
                android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_fx_done"
                android:indeterminateTint="#FFFFFFFF" android:importantForAccessibility="no" />
            <!-- /fx -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/big" style="@style/WidgetFigure"
                    android:layout_width="56dp" android:layout_height="22dp" android:gravity="center"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="17sp"
                    android:autoSizeStepGranularity="0.5sp" />
                <Chronometer android:id="@+id/clock" style="@style/WidgetFigure" android:textSize="15sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
                <TextView android:id="@+id/ring_sub" style="@style/WidgetSub" android:textSize="10.5sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/caption" style="@style/WidgetSub" android:textSize="11.5sp"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <FrameLayout android:id="@+id/fab" android:layout_width="30dp" android:layout_height="30dp">
                <ImageView android:id="@+id/fab_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_pill" android:importantForAccessibility="no" />
                <!-- fx -->
                <ProgressBar android:id="@+id/fx_shimmer" android:layout_width="match_parent" android:layout_height="match_parent"
                android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_fx_shimmer_dot"
                android:indeterminateTint="#FFFFFFFF" android:importantForAccessibility="no" />
                <!-- /fx -->
                <ImageView android:id="@+id/fab_icon" android:layout_width="14dp" android:layout_height="14dp"
                    android:layout_gravity="center" android:src="@drawable/ic_w_lock" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
