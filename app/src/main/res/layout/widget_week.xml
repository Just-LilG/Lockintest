<?xml version="1.0" encoding="utf-8"?>
<!-- This week, 4x2: the week's total, the change on last week, the streak, and a bar for each day. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_fill" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/glow" android:layout_width="200dp" android:layout_height="130dp"
        android:layout_gravity="end|top" android:layout_marginEnd="-40dp" android:layout_marginTop="-34dp"
        android:scaleType="fitXY" android:src="@drawable/widget_glow" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/sheen" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_sheen" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/rim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_rim" android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="10dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/head_label" style="@style/WidgetCap"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/widget_week_label" />
            <FrameLayout android:id="@+id/chip" android:layout_width="wrap_content" android:layout_height="22dp">
                <ImageView android:id="@+id/chip_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_pill" android:importantForAccessibility="no" />
                <TextView android:id="@+id/chip_text" style="@style/WidgetSub" android:textSize="11.5sp"
                    android:fontVariationSettings="\'wght\' 600"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:paddingStart="8dp" android:paddingEnd="8dp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:baselineAligned="true" android:layout_marginTop="2dp">
            <TextView android:id="@+id/big" style="@style/WidgetFigure" android:textSize="27sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/streak_icon" android:layout_width="12dp" android:layout_height="12dp"
                android:layout_marginStart="10dp" android:layout_gravity="center_vertical"
                android:src="@drawable/ic_w_flame" android:importantForAccessibility="no" />
            <TextView android:id="@+id/streak_text" style="@style/WidgetSub"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_gravity="center_vertical" android:layout_marginStart="4dp" />
            <!-- The best day of the week, when there is room for it. -->
            <LinearLayout android:id="@+id/best" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_gravity="center_vertical" android:gravity="end" android:visibility="gone">
                <TextView android:id="@+id/best_label" style="@style/WidgetCap" android:textSize="8.5sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_week_best" />
                <TextView android:id="@+id/best_value" style="@style/WidgetSub" android:textSize="12.5sp"
                    android:fontVariationSettings="\'wght\' 600"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="6dp">
            <ImageView android:id="@+id/bars" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" />
            <!-- fx -->
            <ProgressBar android:id="@+id/fx_glint" android:layout_width="match_parent" android:layout_height="match_parent"
                android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/w_fx_glint"
                android:indeterminateTint="#FFFFFFFF" android:importantForAccessibility="no" />
            <!-- /fx -->
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
