<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain ink splash: our own opening scene starts on the first drawn frame. -->
    <style name="Theme.LockIn.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.LockIn</item>
    </style>

    <style name="Theme.LockIn" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
