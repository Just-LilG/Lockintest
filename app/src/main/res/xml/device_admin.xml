<?xml version="1.0" encoding="utf-8"?>
<!-- What LockIn asks to be allowed to do as a device admin. Being an active admin is also what stops
     the app from being uninstalled until the admin is switched off in Settings. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
